{
    "name": "geshu-electron-template",
    "version": "1.0.0",
    "private": true,
    "type": "module",
    "main": "dist-electron/main.js",
    "scripts": {
        "build": "pnpm run build:renderer && pnpm run build:electron",
        "build:renderer": "rsbuild build",
        "build:electron": "tsc -p tsconfig.electron.json",
        "dev": "concurrently -k \"pnpm run dev:renderer\" \"pnpm run dev:electron\"",
        "dev:renderer": "rsbuild dev",
        "dev:electron": "node ./scripts/wait-renderer.mjs && pnpm run build:electron && node ./scripts/run-electron.mjs --development .",
        "start": "pnpm run build && node ./scripts/run-electron.mjs .",
        "preview": "rsbuild preview",
        "format": "prettier --write .",
        "fg": "pnpm run format && git add . && git commit -m \"feat: format\"",
        "prepare": "husky",
        "lint": "eslint ."
    },
    "dependencies": {
        "@ant-design/cssinjs": "^2.1.2",
        "@fontsource-variable/inter": "^5.3.0",
        "@fontsource-variable/noto-sans-sc": "^5.3.0",
        "@tanstack/react-query": "^5.103.1",
        "antd": "^6.6.5",
        "core-js": "^3.50.0",
        "dayjs": "^1.11.23",
        "deepsea-tools": "^5.48.5",
        "react": "^19.3.0",
        "react-dom": "^19.3.0",
        "react-router": "^8.4.0",
        "soda-antd": "^1.0.37",
        "soda-tanstack-query": "^0.0.16"
    },
    "devDependencies": {
        "@1adybug/eslint": "^0.0.17",
        "@1adybug/prettier": "^0.0.33",
        "@rsbuild/core": "^2.2.8",
        "@rsbuild/plugin-babel": "^2.1.0",
        "@rsbuild/plugin-react": "^2.0.1",
        "@rsbuild/plugin-svgr": "^2.0.5",
        "@types/node": "^24.13.2",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "autoprefixer": "^10.6.1",
        "concurrently": "^10.0.3",
        "electron": "^42.4.1",
        "eslint": "^9.39.5",
        "husky": "^9.1.7",
        "lint-staged": "^17.5.1",
        "postcss": "^8.5.28",
        "postcss-load-config": "^6.0.1",
        "prettier": "^3.9.8",
        "sdrr": "^0.2.10",
        "tailwindcss": "^3.4.19",
        "typescript": "^6.0.3",
        "wait-on": "^9.0.4"
    },
    "lint-staged": {
        "**/*": "prettier --write --ignore-unknown"
    }
}
